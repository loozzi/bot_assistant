# =============================================================================
# TELEGRAM
# =============================================================================
TELEGRAM_BOT_TOKEN=

# =============================================================================
# LLM PROVIDER
# =============================================================================
LLM_PROVIDER=            # name registered in provider registry (e.g. openai, anthropic)
LLM_API_KEY=
LLM_MODEL=               # e.g. gpt-4o, claude-sonnet-4-6
LLM_BASE_URL=            # leave empty unless using a custom/proxy endpoint
LLM_TEMPERATURE=0.7       # temperature for LLM responses (default: 0.7)
LLM_MAX_TOKENS=1024       # max tokens for LLM responses (default: 1024)

# =============================================================================
# EMBEDDING
# =============================================================================
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DEVICE=cpu     # cpu | cuda

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_HOST=localhost   # use "postgres" when running inside docker compose
POSTGRES_PORT=5432
POSTGRES_DB=secondbrain
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=localhost      # use "redis" when running inside docker compose
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SESSION=14400  # working memory TTL in seconds (default: 4 hours)

# =============================================================================
# QDRANT
# =============================================================================
QDRANT_HOST=localhost     # use "qdrant" when running inside docker compose
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=secondbrain

# =============================================================================
# SEARCH AGENT TOOLS
# =============================================================================
TAVILY_API_KEY=           # Tavily web search API key (https://tavily.com)
JINA_API_KEY=             # Optional: Jina Reader API key for enhanced crawling

# =============================================================================
# APP
# =============================================================================
LOG_LEVEL=INFO
ENVIRONMENT=development  # development | production
